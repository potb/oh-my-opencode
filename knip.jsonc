{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "script/**/*.ts",
    "tests/**/*.ts"
  ],
  "ignoreFiles": [
    "src/agents/sisyphus/index.ts",
    "src/features/claude-code-command-loader/index.ts",
    "src/features/opencode-skill-loader/index.ts",
    "src/features/run-continuation-state/index.ts"
  ],
  "ignoreIssues": {
    "tests/hashline/**": [
      "unlisted"
    ],
    "src/agents/sisyphus/index.ts": [
      "exports",
      "types"
    ],
    "src/agents/sisyphus-junior/index.ts": [
      "exports",
      "types"
    ],
    "src/config/index.ts": [
      "exports",
      "types"
    ],
    "src/config/schema.ts": [
      "exports",
      "types"
    ],
    "src/features/claude-code-command-loader/index.ts": [
      "exports",
      "types"
    ],
    "src/features/opencode-skill-loader/index.ts": [
      "exports",
      "types"
    ],
    "src/features/run-continuation-state/index.ts": [
      "exports",
      "types"
    ],
    "src/plugin-handlers/index.ts": [
      "exports",
      "types"
    ],
    "src/tools/index.ts": [
      "exports",
      "types"
    ]
  },
  "project": [
    "src/**/*.ts",
    "script/**/*.ts",
    "tests/**/*.ts"
  ]
}

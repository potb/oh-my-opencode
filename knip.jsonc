{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "script/**/*.ts",
    "tests/**/*.ts"
  ],
  "ignoreIssues": {
    "src/plugin/ultrawork-model-override.ts": [
      "exports"
    ],
    "src/shared/connected-providers-cache.ts": [
      "exports"
    ],
    "src/shared/zip-entry-listing/tar-zip-entry-listing.ts": [
      "exports"
    ]
  },
  "project": [
    "src/**/*.ts",
    "script/**/*.ts",
    "tests/**/*.ts"
  ]
}

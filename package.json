{
  "name": "oh-my-opencode",
  "version": "3.17.2",
  "description": "The Best AI Agent Harness - Batteries-Included OpenCode Plugin with Multi-Model Orchestration, Parallel Background Agents, and Crafted LSP/AST Tools",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target bun --format esm --external @ast-grep/napi && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "plugin",
    "oracle",
    "librarian",
    "agents",
    "ai",
    "llm"
  ],
  "author": "YeonGyu-Kim",
  "license": "SUL-1.0",
  "dependencies": {
    "@ast-grep/cli": "^0.41.1",
    "@opencode-ai/plugin": "^1.4.0",
    "vscode-jsonrpc": "^8.2.0"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.4.0",
    "bun-types": "1.3.11",
    "knip": "^6.6.2",
    "typescript": "^5.7.3"
  },
  "overrides": {},
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
